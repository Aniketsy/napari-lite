diff --git a/src/napari/layers/utils/layer_utils.py b/src/napari/layers/utils/layer_utils.py
index c9601784..591e148c 100644
--- a/src/napari/layers/utils/layer_utils.py
+++ b/src/napari/layers/utils/layer_utils.py
@@ -1273,3 +1273,24 @@ def _unique_element(array: Array) -> Any | None:
     if np.any(array[1:] != el):
         return None
     return el
+
+
+def zoom_nearest(image: np.ndarray, zoom: Sequence[float]) -> np.ndarray:
+    """Resample ``image`` by ``zoom`` with nearest-neighbour lookup.
+
+    The same pixels as ``scipy.ndimage.zoom(image, zoom, order=0,
+    prefilter=False)``: output index ``i`` reads input index
+    ``round(i * (n_in - 1) / (n_out - 1))`` on every axis.  Where
+    floating-point error puts the last coordinate a hair past the last
+    pixel, scipy's default mode fills that row with zeros; the edge pixel
+    is used here instead.  Used for the layer thumbnails, where importing
+    ``scipy.ndimage`` (about 200 modules) was a large part of the cost of
+    the first image.
+    """
+    index = []
+    for n_in, factor in zip(image.shape, zoom, strict=True):
+        n_out = round(n_in * factor)
+        ratio = (n_in - 1) / (n_out - 1) if n_out > 1 else 1.0
+        positions = np.floor(np.arange(n_out) * ratio + 0.5).astype(np.intp)
+        index.append(np.clip(positions, 0, max(n_in - 1, 0)))
+    return image[np.ix_(*index)]
